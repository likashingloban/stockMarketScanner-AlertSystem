<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Watchlist - Stock Watch</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">

    <style>
        .stock-checkbox {
            cursor: pointer;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="dashboard.html">📈 Stock Watch</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="dashboard.html">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" href="watchlist.html">Watchlist</a></li>
                    <li class="nav-item"><a class="nav-link" href="alerts.html">Alerts</a></li>

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar me-2">
                                <span id="userInitial"></span>
                            </div>
                            <span id="username"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="#" id="settingsBtn">⚙️ Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" id="logoutBtn">🚪 Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">
        <!-- Comparison Chart -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="card-title mb-0">价格对比图表</h4>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary active" onclick="updateComparisonChart('1h')">1小时</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="updateComparisonChart('24h')">24小时</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="updateComparisonChart('7d')">7天</button>
                            </div>
                        </div>
                        <div id="comparisonChartContainer" class="d-none">
                            <div id="comparisonChart" style="width: 100%; height: 450px;"></div>
                        </div>
                        <div id="noSelectionMessage" class="text-center text-muted py-5">
                            <p>📊 请在下方表格中勾选股票以显示对比图表</p>
                            <small>最多可选择 5 只股票进行对比</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Watchlist Table -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <h2 class="card-title mb-4">我的观察清单</h2>

                        <!-- Add Stock Form -->
                        <div class="row mb-4">
                            <div class="col-md-8">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="stockSymbolInput"
                                           placeholder="输入股票代码 (例如: AAPL, TSLA)">
                                    <button class="btn btn-primary" type="button" id="addStockBtn">
                                        添加股票
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Alert Message -->
                        <div id="alertMessage" class="alert d-none" role="alert"></div>

                        <!-- Watchlist Table -->
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th width="50">
                                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input stock-checkbox" title="全选/取消">
                                        </th>
                                        <th>代码</th>
                                        <th>名称</th>
                                        <th>当前价格</th>
                                        <th>涨跌额</th>
                                        <th>涨跌幅</th>
                                        <th>更新时间</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody id="watchlistTable">
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">加载中...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <script src="js/modal.js"></script>
    <script src="js/config.js"></script>

    <script>
        // Check authentication
        if (!checkAuth()) {
            throw new Error('Not authenticated');
        }

        const user = Storage.getUser();

        // Set user initial
        const initial = user.username.charAt(0).toUpperCase();
        document.getElementById('userInitial').textContent = initial;
        document.getElementById('username').textContent = user.username;

        // Global variables
        let comparisonChart = null;
        let currentRange = '1h';
        let allStocks = [];
        const selectedStocks = new Set();
        const MAX_SELECTION = 5;

        // Colors for different stocks
        const stockColors = [
            '#4bc0c0', '#ff6384', '#36a2eb', '#ffce56', '#9966ff'
        ];

        // Load watchlist
        async function loadWatchlist() {
            try {
                const stocks = await apiRequest(`${CONFIG.API_ENDPOINTS.WATCHLIST}/${user.id}`);
                allStocks = stocks;
                renderWatchlist(stocks);
            } catch (error) {
                showAlert('加载观察清单失败: ' + error.message, 'danger');
            }
        }

        // Render watchlist
        function renderWatchlist(stocks) {
            const tbody = document.getElementById('watchlistTable');

            if (stocks.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">观察清单为空</td></tr>';
                return;
            }

            tbody.innerHTML = stocks.map(stock => `
                <tr>
                    <td>
                        <input type="checkbox"
                               class="form-check-input stock-checkbox stock-select-checkbox"
                               data-symbol="${stock.stock_symbol}"
                               onchange="handleStockSelection('${stock.stock_symbol}', this.checked)">
                    </td>
                    <td><strong>${stock.stock_symbol}</strong></td>
                    <td>${stock.stock_name || '-'}</td>
                    <td>$${stock.current_price ? stock.current_price.toFixed(2) : '-'}</td>
                    <td class="${stock.change_amount >= 0 ? 'text-success' : 'text-danger'}">
                        ${stock.change_amount ? stock.change_amount.toFixed(2) : '-'}
                    </td>
                    <td class="${stock.change_percent >= 0 ? 'text-success' : 'text-danger'}">
                        ${stock.change_percent ? stock.change_percent.toFixed(2) + '%' : '-'}
                    </td>
                    <td>${stock.updated_at ? new Date(stock.updated_at).toLocaleString('zh-CN') : '-'}</td>
                    <td>
                        <button class="btn btn-sm btn-info" onclick="viewDetail('${stock.stock_symbol}')">详情</button>
                        <button class="btn btn-sm btn-danger" onclick="removeStock(${stock.id})">删除</button>
                    </td>
                </tr>
            `).join('');
        }

        // Handle stock selection
        function handleStockSelection(symbol, isChecked) {
            if (isChecked) {
                if (selectedStocks.size >= MAX_SELECTION) {
                    showAlert(`最多只能选择 ${MAX_SELECTION} 只股票进行对比`, 'warning');
                    // Uncheck the checkbox
                    document.querySelector(`input[data-symbol="${symbol}"]`).checked = false;
                    return;
                }
                selectedStocks.add(symbol);
            } else {
                selectedStocks.delete(symbol);
            }

            // Update select all checkbox
            updateSelectAllCheckbox();

            // Update chart
            updateComparisonChart(currentRange);
        }

        // Select all checkbox handler
        document.getElementById('selectAllCheckbox').addEventListener('change', function(e) {
            const isChecked = e.target.checked;
            const checkboxes = document.querySelectorAll('.stock-select-checkbox');

            selectedStocks.clear();

            if (isChecked) {
                let count = 0;
                checkboxes.forEach(checkbox => {
                    if (count < MAX_SELECTION) {
                        checkbox.checked = true;
                        selectedStocks.add(checkbox.dataset.symbol);
                        count++;
                    }
                });

                if (checkboxes.length > MAX_SELECTION) {
                    showAlert(`已选择前 ${MAX_SELECTION} 只股票（最多支持 ${MAX_SELECTION} 只）`, 'info');
                }
            } else {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = false;
                });
            }

            updateComparisonChart(currentRange);
        });

        // Update select all checkbox state
        function updateSelectAllCheckbox() {
            const checkboxes = document.querySelectorAll('.stock-select-checkbox');
            const checkedCount = document.querySelectorAll('.stock-select-checkbox:checked').length;
            const selectAllCheckbox = document.getElementById('selectAllCheckbox');

            if (checkedCount === 0) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = false;
            } else if (checkedCount === checkboxes.length) {
                selectAllCheckbox.checked = true;
                selectAllCheckbox.indeterminate = false;
            } else {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = true;
            }
        }

        // Update comparison chart
        async function updateComparisonChart(range = '1h') {
            currentRange = range;

            // Update active button
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event?.target?.classList?.add('active');

            if (selectedStocks.size === 0) {
                // Hide chart, show message
                document.getElementById('comparisonChartContainer').classList.add('d-none');
                document.getElementById('noSelectionMessage').classList.remove('d-none');
                return;
            }

            // Show chart, hide message
            document.getElementById('comparisonChartContainer').classList.remove('d-none');
            document.getElementById('noSelectionMessage').classList.add('d-none');

            try {
                // Fetch history for all selected stocks
                const historyPromises = Array.from(selectedStocks).map(symbol =>
                    apiRequest(`${CONFIG.API_ENDPOINTS.STOCK_HISTORY}/${symbol}/history?range=${range}`)
                        .then(data => ({ symbol, data }))
                );

                const histories = await Promise.all(historyPromises);

                // Initialize chart if needed
                const chartDom = document.getElementById('comparisonChart');
                if (!comparisonChart) {
                    comparisonChart = echarts.init(chartDom);
                }

                // Prepare series data
                const series = histories.map((item, index) => ({
                    name: item.symbol,
                    type: 'line',
                    smooth: true,
                    symbol: 'circle',
                    symbolSize: 4,
                    data: item.data.map(d => d.price),
                    lineStyle: {
                        width: 2,
                        color: stockColors[index % stockColors.length]
                    },
                    itemStyle: {
                        color: stockColors[index % stockColors.length]
                    }
                }));

                // Get all times (assuming all stocks have same times)
                const times = histories[0]?.data.map(d => d.time) || [];

                // Range labels
                const rangeLabels = {
                    '1h': '最近 1 小时',
                    '24h': '最近 24 小时',
                    '7d': '最近 7 天'
                };

                // Configure chart options
                const option = {
                    title: {
                        text: `股票价格对比 - ${rangeLabels[range] || range}`,
                        left: 'center',
                        textStyle: {
                            fontSize: 16,
                            fontWeight: 'normal'
                        }
                    },
                    tooltip: {
                        trigger: 'axis',
                        axisPointer: {
                            type: 'cross'
                        },
                        formatter: function(params) {
                            let result = `${params[0].name}<br/>`;
                            params.forEach(param => {
                                result += `${param.marker} ${param.seriesName}: $${param.value.toFixed(2)}<br/>`;
                            });
                            return result;
                        }
                    },
                    legend: {
                        data: Array.from(selectedStocks),
                        top: 35,
                        textStyle: {
                            fontSize: 12
                        }
                    },
                    grid: {
                        left: '3%',
                        right: '4%',
                        bottom: '3%',
                        top: 80,
                        containLabel: true
                    },
                    xAxis: {
                        type: 'category',
                        boundaryGap: false,
                        data: times,
                        axisLabel: {
                            rotate: 45,
                            fontSize: 10
                        }
                    },
                    yAxis: {
                        type: 'value',
                        scale: true,
                        axisLabel: {
                            formatter: '${value}'
                        }
                    },
                    series: series
                };

                // Set option
                comparisonChart.setOption(option, true);

                // Responsive resize
                window.addEventListener('resize', function() {
                    comparisonChart?.resize();
                });

            } catch (error) {
                console.error('加载对比图表失败:', error);
                showAlert('加载对比图表失败: ' + error.message, 'danger');
            }
        }

        // Add stock
        document.getElementById('addStockBtn').addEventListener('click', async () => {
            const symbol = document.getElementById('stockSymbolInput').value.trim().toUpperCase();

            if (!symbol) {
                showAlert('请输入股票代码', 'warning');
                return;
            }

            try {
                await apiRequest(CONFIG.API_ENDPOINTS.WATCHLIST, {
                    method: 'POST',
                    body: JSON.stringify({
                        user_id: user.id,
                        stock_symbol: symbol
                    })
                });

                showAlert(`${symbol} 已添加到观察清单`, 'success');
                document.getElementById('stockSymbolInput').value = '';
                loadWatchlist();
            } catch (error) {
                showAlert(error.message, 'danger');
            }
        });

        // Remove stock
        async function removeStock(watchlistId) {
            const confirmed = await Modal.confirm(
                '确定要删除这只股票吗？',
                '删除股票',
                { confirmText: '删除', confirmClass: 'btn-danger', icon: '🗑️' }
            );

            if (!confirmed) return;

            try {
                await apiRequest(`${CONFIG.API_ENDPOINTS.WATCHLIST}/${watchlistId}`, {
                    method: 'DELETE'
                });

                showAlert('删除成功', 'success');

                // Clear selection and reload
                selectedStocks.clear();
                loadWatchlist();
            } catch (error) {
                showAlert(error.message, 'danger');
            }
        }

        // View details
        function viewDetail(symbol) {
            Navigation.toStockDetail(symbol);
        }

        // Show alert
        function showAlert(message, type) {
            const alert = document.getElementById('alertMessage');
            alert.className = `alert alert-${type}`;
            alert.textContent = message;
            alert.classList.remove('d-none');

            setTimeout(() => {
                alert.classList.add('d-none');
            }, 3000);
        }

        // Settings button
        document.getElementById('settingsBtn').addEventListener('click', (e) => {
            e.preventDefault();
            Navigation.toSettings();
        });

        // Logout
        document.getElementById('logoutBtn').addEventListener('click', async (e) => {
            e.preventDefault();
            const confirmed = await Modal.confirm(
                'Are you sure you want to logout?',
                'Confirm Logout',
                { confirmText: 'Logout', confirmClass: 'btn-danger', icon: '🚪' }
            );
            if (confirmed) {
                Storage.clearUser();
                Navigation.toLogin();
            }
        });

        // Load on page load
        loadWatchlist();
    </script>
</body>
</html>
